{
  "version": 1,
  "about": "Days you showed up (1.4 C, UX 18 Nov). A day = a check-in with a mood 1-5, one per date (the profile's local dates). Windows end today; later rows are ignored. week = today-6..today; month = today-29..today; threeMonths = today-89..today (Insights' tabs); year = the 1st of the month 11 months back..today (Plus's Year: 12 calendar months, this one included); all = every day up to today (Plus's All time). Never a streak, a chain or a 'don't break it'. 0 days: the line is hidden, never '0 days' (UX, 18 Nov); expect says 'hidden'. checkIns are [date, mood]. Written by the Mobile Dev (tool: generated by a separate implementation); the web mirrors it.",
  "copy": {
    "en": "{count, plural, one {You showed up on {count} day} other {You showed up on {count} days}} {range, select, week {in the last 7 days} month {in the last 30 days} threeMonths {in the last 3 months} year {in the last 12 months} other {since you started}}.",
    "shareMonth": "{n, plural, =1{Showed up on 1 day} other{Showed up on {n} days}}"
  },
  "ranges": [
    "week",
    "month",
    "threeMonths",
    "year",
    "all"
  ],
  "cases": [
    {
      "name": "week: today and 6 days back count; 7 back and tomorrow do not",
      "today": "2026-11-18",
      "checkIns": [
        [
          "2026-11-18",
          3
        ],
        [
          "2026-11-12",
          4
        ],
        [
          "2026-11-11",
          2
        ],
        [
          "2026-11-19",
          5
        ]
      ],
      "expect": {
        "week": 2,
        "month": 3,
        "threeMonths": 3,
        "year": 3,
        "all": 3
      }
    },
    {
      "name": "one per date; a mood outside 1-5 is not a day",
      "today": "2026-11-18",
      "checkIns": [
        [
          "2026-11-17",
          3
        ],
        [
          "2026-11-17",
          4
        ],
        [
          "2026-11-16",
          0
        ],
        [
          "2026-11-15",
          6
        ],
        [
          "2026-11-14",
          1
        ]
      ],
      "expect": {
        "week": 2,
        "month": 2,
        "threeMonths": 2,
        "year": 2,
        "all": 2
      }
    },
    {
      "name": "month and 3 months: the edges",
      "today": "2026-11-18",
      "checkIns": [
        [
          "2026-10-20",
          3
        ],
        [
          "2026-10-19",
          3
        ],
        [
          "2026-08-21",
          3
        ],
        [
          "2026-08-20",
          3
        ]
      ],
      "expect": {
        "week": "hidden",
        "month": 1,
        "threeMonths": 3,
        "year": 4,
        "all": 4
      }
    },
    {
      "name": "year: 12 calendar months, this one included",
      "today": "2026-11-18",
      "checkIns": [
        [
          "2025-12-01",
          3
        ],
        [
          "2025-11-30",
          3
        ],
        [
          "2026-11-01",
          2
        ]
      ],
      "expect": {
        "week": "hidden",
        "month": 1,
        "threeMonths": 1,
        "year": 2,
        "all": 3
      }
    },
    {
      "name": "year across January",
      "today": "2027-01-05",
      "checkIns": [
        [
          "2026-02-01",
          4
        ],
        [
          "2026-01-31",
          4
        ],
        [
          "2027-01-05",
          4
        ]
      ],
      "expect": {
        "week": 1,
        "month": 1,
        "threeMonths": 1,
        "year": 2,
        "all": 3
      }
    },
    {
      "name": "all time: every day up to today",
      "today": "2026-11-18",
      "checkIns": [
        [
          "2019-03-01",
          3
        ],
        [
          "2024-06-30",
          5
        ],
        [
          "2026-11-18",
          2
        ],
        [
          "2026-12-01",
          4
        ]
      ],
      "expect": {
        "week": 1,
        "month": 1,
        "threeMonths": 1,
        "year": 1,
        "all": 3
      }
    },
    {
      "name": "no check-ins: the line is hidden on every range",
      "today": "2026-11-18",
      "checkIns": [],
      "expect": {
        "week": "hidden",
        "month": "hidden",
        "threeMonths": "hidden",
        "year": "hidden",
        "all": "hidden"
      }
    }
  ]
}
