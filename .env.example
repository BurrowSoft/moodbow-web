# Names only; values live in Vercel (Production/Preview) and are set by the owner.
# Nothing here is needed for local development: without them Sentry stays off.

# Sentry error reporting (runtime). Public by design.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry source-map upload at build time (Vercel only).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
